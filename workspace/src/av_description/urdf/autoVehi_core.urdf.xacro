<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autoVehi">
    
    <xacro:property name="max_effort" value="300"/>
    <xacro:property name="joint_damping" value="0.5"/>

    <xacro:macro name="autoVehi" params="">

        <material name="white">
            <color rgba=" 1 1 1 0.5"/>
        </material>

        <material name="blue">
            <color rgba="0.1 0.1 1 0.5"/>
        </material>

        <material name="red">
            <color rgba="1 0.1 0.1 0.5"/>
        </material>

        <material name="green">
            <color rgba="0.1 1 0.1 0.8"/>
        </material>

        <material name="black">
            <color rgba="1 1 1 0.8"/>
        </material>

        <link name="base_link"></link>

        <joint name="chassis_joint" type="fixed">
            <parent link="base_link"/>
            <child link="chassis_link"/>
            <origin xyz="0 0 0.15"/>
        </joint>

        <link name="chassis_link">
            <inertial>
                <origin xyz="0 0 0.15" rpy="0 0 0"/>
                <mass value="20"/>
                <inertia
                    ixx="0.566" ixy="0" ixz="0"
                    iyy="1.816" iyz="0"
                    izz="2.083"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0.15" rpy="0 0 0"/>
                <geometry>
                    <box size="1 0.5 0.3"/>
                </geometry>
                <material name="blue"/>
            </visual>

            <collision>
                <origin xyz="0 0 0.15" rpy="0 0 0"/>
                <geometry>
                    <box size="1 0.5 0.3"/>
                </geometry>
            </collision>
        </link>
        <!--/////////////// wheel_left_top////////////-->
        <joint name="wheel_left_top_joint" type="continuous">
            <parent link="chassis_link"/>
            <child link="wheel_left_top" />
            <origin xyz="0.3 0.25 0" rpy="${-PI/2} 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="${max_effort}" velocity="${PI}"/>
            <dynamics damping="${joint_damping}"/>
        </joint>

        <link name="wheel_left_top">
            <inertial>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <mass value="1"/>
                <inertia
                    ixx="0.006" ixy="0" ixz="0"
                    iyy="0.006" iyz="0"
                    izz="0.011"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
            </collision>
        </link>

        <!--/////////////// wheel_left_bot////////////-->
        <joint name="wheel_left_bot_joint" type="continuous">
            <parent link="chassis_link"/>
            <child link="wheel_left_bot" />
            <origin xyz="-0.3 0.25 0" rpy="${-PI/2} 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="${max_effort}" velocity="${PI}"/>
            <dynamics damping="${joint_damping}"/>
        </joint>

        <link name="wheel_left_bot">
            <inertial>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <mass value="1"/>
                <inertia
                    ixx="0.006" ixy="0" ixz="0"
                    iyy="0.006" iyz="0"
                    izz="0.011"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
            </collision>
        </link>

        <!--/////////////// wheel_right_top////////////-->
        <joint name="wheel_right_top_joint" type="continuous">
            <parent link="chassis_link"/>
            <child link="wheel_right_top" />
            <origin xyz="0.3 -0.25 0" rpy="${PI/2} 0 0"/>
            <axis xyz="0 0 -1"/>
            <limit effort="${max_effort}" velocity="${PI}"/>
            <dynamics damping="${joint_damping}"/>
        </joint>

        <link name="wheel_right_top">
            <inertial>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <mass value="1"/>
                <inertia
                    ixx="0.006" ixy="0" ixz="0"
                    iyy="0.006" iyz="0"
                    izz="0.011"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
            </collision>
        </link>

        <!--/////////////// wheel_right_bot////////////-->
        <joint name="wheel_right_bot_joint" type="continuous">
            <parent link="chassis_link"/>
            <child link="wheel_right_bot" />
            <origin xyz="-0.3 -0.25 0" rpy="${PI/2} 0 0"/>
            <axis xyz="0 0 -1"/>
            <limit effort="${max_effort}" velocity="${PI}"/>
            <dynamics damping="${joint_damping}"/>
        </joint>

        <link name="wheel_right_bot">
            <inertial>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <mass value="1"/>
                <inertia
                    ixx="0.006" ixy="0" ixz="0"
                    iyy="0.006" iyz="0"
                    izz="0.011"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
                <material name="black"/>
            </visual>

            <collision>
                <origin xyz="0 0 0.06" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.15" length="0.1"/>
                </geometry>
            </collision>
        </link>

        <gazebo reference="wheel_left_top">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.0</mu>
                            <mu2>0.0</mu2>
                            <minDepth>0.001</minDepth>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>

        <gazebo reference="wheel_left_bot">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                            <minDepth>0.001</minDepth>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>

        <gazebo reference="wheel_right_top">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.0</mu>
                            <mu2>0.0</mu2>
                            <minDepth>0.001</minDepth>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>

        <gazebo reference="wheel_right_bot">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                            <minDepth>0.001</minDepth>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>

    </xacro:macro>
    
</robot>